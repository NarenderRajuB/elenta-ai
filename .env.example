# Configuration reference for the ELENTA chat service (REQ-013, REQ-014).
# Copy to .env and adjust. All values here are safe examples: no secrets.
# Full descriptions: README.md (Configuration) until docs/configuration.md is written.

# Required. Base URL of an OpenAI-compatible endpoint; the client appends /chat/completions.
# Ollama native on the macOS/Windows host (ADR-013):
LLM_URL=http://host.docker.internal:11434/v1
# Docker Model Runner (Apple Silicon / supported hosts) would instead be, for example:
# LLM_URL=http://model-runner.docker.internal/engines/v1

# Required. Model identifier passed verbatim to the endpoint (quantised GGUF, <=1B params).
LLM_MODEL=gemma3:1b

# Optional. Interface the HTTP server binds to. Default 127.0.0.1 (local only).
# Inside a container this must be 0.0.0.0 so the published port is reachable.
APP_HOST=127.0.0.1

# Optional. HTTP server port, 1-65535. Default 8000.
APP_PORT=8000

# Optional. Max seconds the /readyz probe waits for the model endpoint. Default 3.
LLM_HEALTH_TIMEOUT_SECONDS=3

# Optional. Corpus root; only files under it are read. Default /data (the container mount).
# For a local run outside Docker use a host path, e.g. CORPUS_DIR=./data (made absolute at startup).
CORPUS_DIR=/data

# Optional. Files larger than this are skipped and reported. Default 52428800 (50 MB).
CORPUS_MAX_FILE_BYTES=52428800

# Optional. Max number of supported files served; extra files are skipped and reported. Default 500.
CORPUS_MAX_FILES=500

# Optional. A file modified within this many seconds is treated as still being written
# and is picked up on a later request. 0 disables the wait. Default 0.5.
CORPUS_SETTLE_SECONDS=0.5

# Optional. Target maximum characters per evidence chunk (paragraph-aware). Default 800 (~200 tokens).
CHUNK_MAX_CHARS=800

# Optional. Maximum estimated tokens of evidence placed in the prompt per question. Default 1500.
# Must stay well below the model server's context window (Ollama pinned to 4096, TS-005).
CONTEXT_TOKEN_BUDGET=1500

# Optional. A chunk must score above this (BM25) to count as evidence. Default 0 =
# "shares at least one meaningful word with the question".
SELECTION_MIN_SCORE=0

# Optional. Model context window in tokens; must match the model server (Ollama pinned to 4096). Default 4096.
LLM_CONTEXT_TOKENS=4096

# Optional. Maximum answer length in tokens, sent to the endpoint as max_tokens. Default 512.
LLM_MAX_TOKENS=512

# Optional. Sampling temperature, 0-2. Default 0 = as repeatable as the server allows (TS-006).
LLM_TEMPERATURE=0

# Optional. Inference timeouts in seconds (positive). Connect: reaching the model server
# (default 5). Read: max wait for the next streamed piece, including the first one,
# which covers prompt processing on CPU (default 60). Request: hard cap on one whole
# model call (default 180). No request can run longer than this.
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=180

# Optional. OTLP/HTTP endpoint of a LOCAL trace collector. Compose sets it to the bundled
# Jaeger (http://jaeger:4318/v1/traces). Empty: traces are created but not exported.
OTLP_TRACES_URL=
