# Configuration reference for the ELENTA chat service (REQ-013, REQ-014).
# Copy to .env and adjust. All values here are safe examples: no secrets.
# Full descriptions: README.md (Configuration) until docs/configuration.md is written.

# Required. Base URL of an OpenAI-compatible endpoint; the client appends /chat/completions.
# Ollama native on the macOS/Windows host (ADR-013):
LLM_URL=http://host.docker.internal:11434/v1
# Docker Model Runner (Apple Silicon / supported hosts) would instead be, for example:
# LLM_URL=http://model-runner.docker.internal/engines/v1

# Required. Model identifier passed verbatim to the endpoint (quantised GGUF, <=1B params).
LLM_MODEL=qwen2.5:0.5b

# Optional. Interface the HTTP server binds to. Default 127.0.0.1 (local only).
# Inside a container this must be 0.0.0.0 so the published port is reachable.
APP_HOST=127.0.0.1

# Optional. HTTP server port, 1-65535. Default 8000.
APP_PORT=8000

# Optional. Max seconds the /readyz probe waits for the model endpoint. Default 3.
LLM_HEALTH_TIMEOUT_SECONDS=3
